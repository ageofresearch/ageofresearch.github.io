    {
      "declaration": "FixedPerimeter.fixedPerimeter_eq_two",
      "source_file": "lean4/FixedPerimeter/CountBridge.lean",
      "interpretation": "For every natural j and n, FD j 2 n equals FO j 2 n."
    },
    {
      "declaration": "FixedPerimeter.fixedPerimeter_ratio_tendsto_zero",
      "source_file": "lean4/FixedPerimeter/MainTheorems.lean",
      "interpretation": "For fixed natural j and k with 3 <= k, the real sequence FO j k n / FD j k n tends to zero as n tends to infinity."
    },
    {
      "declaration": "FixedPerimeter.fixedPerimeter_eventually_strict",
      "source_file": "lean4/FixedPerimeter/MainTheorems.lean",
      "interpretation": "For fixed natural j and k with 3 <= k, there is a threshold after which FO j k n is strictly less than FD j k n."
    }
